DATABASE_URL=postgresql+psycopg2://venky@localhost:5432/oral
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ID_PHOTO_STORAGE_DIR=storage/id_photos

# Comma-separated allowed frontend origin(s). Set to the deployed Vercel
# domain in production — defaults to local dev only.
CORS_ORIGINS=http://localhost:3000

# Embeddings: unset in dev (falls back to locally-run Ollama). Set for
# production — switches RAG embeddings off Ollama onto Gemini.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
